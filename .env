# ============================================================================
# Franciscan Application Environment Variables
# Copy this file to .env and update with your values
# ============================================================================

# SQL Server Configuration
MSSQL_SA_PASSWORD=FranciscanSA@2024
MSSQL_PID=Developer
MSSQL_BACKUP_FILE=FransiscanLive.bak

# Backend API Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database Connection (for backend)
DB_SERVER=mssql
DB_PORT=1433
DB_DATABASE=FransiscanLive
DB_USER=franciscan_app
DB_PASSWORD=FranciscanApp@2024
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-USE-STRONG-RANDOM-KEY
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=http://localhost:3001
CORS_CREDENTIALS=true

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# Frontend Configuration (Vite)
VITE_API_BASE=http://localhost:3000

# Mail Configuration (Optional)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Franciscan Columbarium

