# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Database Configuration (SQL Server)
DB_SERVER=.\SQLEXPRESS
DB_DATABASE=FransiscanTest
DB_USER=JENIVER\geniv
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECTION_TIMEOUT=30000
DB_REQUEST_TIMEOUT=30000
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT=30000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# CORS Configuration
CORS_ORIGIN=http://192.168.1.24:3000
CORS_CREDENTIALS=true

# Application Configuration
APP_NAME=Franciscan Backend API
APP_VERSION=1.0.0
APP_DESCRIPTION=Production-ready Node.js backend for Franciscan application

# Reporting Configuration
REPORT_CACHE_ENABLED=true
REPORT_CACHE_TTL=3600
REPORT_DEFAULT_FORMAT=json

# Mail Configuration
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM="Franciscan Columbarium" <no-reply@example.com>