{
  "name": "franciscan-nodejs-be",
  "version": "1.0.0",
  "description": "Production-ready Node.js backend for Franciscan application",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/",
    "test-db": "node -e \"require('dotenv').config(); const { connectDatabase } = require('./src/config/database'); connectDatabase().then(() => { console.log('✅ Database connected successfully!'); process.exit(0); }).catch(err => { console.error('❌ Database connection failed:', err.message); process.exit(1); });\"",
    "fix-permissions": "node scripts/fix-receipt-report-permissions.js",
    "diagnose": "node scripts/diagnose-niche-booking.js",
    "diagnose-db": "node scripts/diagnose-db-connection.js",
    "docker:build": "docker build -t franciscan-api .",
    "docker:run": "docker run -p 3000:3000 --env-file .env franciscan-api",
    "docker:compose": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "logs": "docker-compose logs -f franciscan-api"
  },
  "keywords": [
    "nodejs",
    "express",
    "sql-server",
    "franciscan",
    "api",
    "rest",
    "jwt",
    "authentication"
  ],
  "author": "Franciscan Development Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "meilisearch": "^0.55.0",
    "morgan": "^1.10.0",
    "msnodesqlv8": "^5.1.1",
    "mssql": "^10.0.1",
    "node-cache": "^5.1.2",
    "nodemailer": "^6.10.1",
    "puppeteer": "^24.26.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/app.js",
      "!src/config/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ]
  }
}
